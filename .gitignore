# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.log

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# Build output & distribution packages
dist/
release/
*.zip

# Runtime / lock files
*.port

# AI Agent memory & config
.mimocode/
.claude/
.uploads/
.cursor/
.aider/
.workbuddy/
.codeartsdoer/
.codebuddy/

# IDE/Tool config
.trae/
.playwright-cli/

# Generated media / export working dirs
**/_probe/
**/clips/
**/docs/video/

# xhs-video: 源码/配置/README 要入库，只忽略工作目录与产物
# 技能真源见 .skill/demo-video-recorder/；项目实例由各项目的 caption_config.json 驱动
**/xhs-video/.work/
**/xhs-video/preview/
**/xhs-video/*.mp4
**/xhs-video/*.png
**/xhs-video/*.jpg
**/xhs-video/*.ttf

# _dev working dirs: ignore generated artifacts (previews/caches), keep build scripts tracked
**/_dev/**/*.png
**/_dev/**/*.pyc
**/_dev/__pycache__/
# world-food-3d _dev is pure scratch (fully untracked) — ignore the whole dir
vibeknow/world-food-3d/_dev/

# Project-specific generated promo (all xiaohongshu dirs)
**/xiaohongshu/*.mp4
**/xiaohongshu/screenshots/

# Password manager sensitive files
data.enc
hint.txt
backups/
