# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.log

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# Build output & distribution packages
dist/
release/
*.zip

# Runtime / lock files
*.port

# AI Agent memory & config
.mimocode/
.claude/
.uploads/
.cursor/
.aider/
.workbuddy/
.codeartsdoer/
.codebuddy/

# IDE/Tool config
.trae/
.playwright-cli/

# Generated media / export working dirs
**/_probe/
**/clips/
**/docs/video/

# 截图与预览痕迹（可由脚本重建，见 CONVENTIONS.md 第五节）
**/_shots/
**/.shots/
**/_preview_*.png
**/_preview_*.jpg
**/shot-*.png
**/screenshot-*.png
**/docs/shots/
# 项目根独立截图目录（构建/验证脚本产出的成品图，可由脚本重建）
# 注意：xiaohongshu/screenshots/ 与 promo-screenshots/ 是交付物料，须入库，不在此列
vibeknow/molecule/screenshots/
# 探针 / 调试输出的无扩展名与 .txt 痕迹
**/_*.txt
**/_*_log.txt

# 项目工程中间目录（脚本须在 tools/ 或 tests/，见 CONVENTIONS.md 第三节）
**/_dev/_shots/

# 项目工作目录：人工放入的原始输入（原图 / 参考照 / 旧版图），不入库
# 见 CONVENTIONS.md 第三节「外部工作输入」
**/.work/

# xhs-video: 源码/配置/README 要入库，只忽略工作目录与产物
# 技能真源见 .skill/demo-video-recorder/；项目实例由各项目的 caption_config.json 驱动
**/xhs-video/.work/
**/xhs-video/preview/
# 工作目录（整目录忽略，含其中的 jpg/json 等中间产物）
**/xhs-video/clips_old_*/
**/xhs-video/_cand/
# 产物媒体（递归匹配顶层与任意子目录）
**/xhs-video/**/*.mp4
**/xhs-video/**/*.png
**/xhs-video/**/*.jpg
**/xhs-video/**/*.jpeg
**/xhs-video/**/*.ttf
**/xhs-video/**/*.webp

# _dev working dirs: ignore generated artifacts (previews/caches), keep build scripts tracked
**/_dev/**/*.png
**/_dev/**/*.pyc
**/_dev/__pycache__/
# world-food-3d _dev is pure scratch (fully untracked) — ignore the whole dir
vibeknow/world-food-3d/_dev/

# Project-specific generated promo (all xiaohongshu dirs)
**/xiaohongshu/*.mp4
**/xiaohongshu/screenshots/

# Password manager sensitive files
data.enc
hint.txt
backups/
