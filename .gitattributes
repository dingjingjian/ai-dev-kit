# 行尾统一策略（见 CONVENTIONS.md 第五节）
# 默认：文本文件在仓库与工作区一律 LF，避免 Windows 上 CRLF/LF 抖动，
# 以及 core.autocrlf=true 产生的 "LF will be replaced by CRLF" 刷屏警告。
* text=auto eol=lf

# Windows 原生脚本对换行敏感，必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须 LF，否则在容器 / CI 中无法执行
*.sh text eol=lf

# 二进制资源：禁止行尾与编码转换，也不参与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.mp3   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.glb   binary
*.docx  binary
*.xlsx  binary
*.pdf   binary
