{
  "name": "molecule",
  "entry": "dist/index.html",
  "include": [
    "dist"
  ],
  "allowedExt": [
    ".html",
    ".js",
    ".css",
    ".json",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".svg",
    ".woff",
    ".woff2"
  ],
  "maxZipBytes": 10485760,
  "guards": [
    "entry-exists",
    "entry-at-root",
    "size-budget"
  ],
  "prebuild": "tools/build.mjs",
  "zipRoot": "dist",
  "zip": "molecule.zip"
}
