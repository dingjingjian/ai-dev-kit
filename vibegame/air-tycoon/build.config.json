{
  "name": "air-tycoon",
  "entry": "dist/index.html",
  "include": [
    "dist"
  ],
  "allowedExt": [
    ".html",
    ".js",
    ".css",
    ".json",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".svg",
    ".woff",
    ".woff2"
  ],
  "maxZipBytes": 10485760,
  "guards": [
    "entry-exists",
    "entry-at-root",
    "size-budget"
  ],
  "zip": "air-tycoon.zip",
  "prebuild": "tools/build_dist.py",
  "prebuildArgs": [
    "--no-pack"
  ],
  "zipRoot": "dist",
  "exclude": [
    "dist/assets/earth.jpg",
    "dist/assets/earth-night.jpg"
  ]
}
